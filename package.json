{
  "name": "topi-harness",
  "version": "1.0.0",
  "description": "Free LLM harness with Headroom-like dashboard",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "concurrently \"npm run start:server\" \"npm run start:dashboard\"",
    "start:server": "node dist/server.js",
    "start:dashboard": "cd dashboard && npm run dev",
    "dev": "concurrently \"ts-node src/server.ts\" \"cd dashboard && npm run dev\"",
    "cli": "node dist/cli.js",
    "dev:cli": "ts-node src/cli.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "chalk": "^5.3.0",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "groq-sdk": "^0.7.0",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "readline": "^1.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
