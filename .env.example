# ========================================================
# Topi Harness / LLM Proxy - Environment Variables
# ========================================================

# Topi Dashboard Configuration
# Determines compression percentage savings. 
# Options: 'free' (40%), 'pro' (70%), 'enterprise' (90%)
TOPI_TIER=free

# ========================================================
# API Keys for Cloud Providers
# ========================================================

# Moonshot AI (Kimi)
KIMI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Alibaba (Qwen / DashScope)
QWEN_API_KEY=

# Groq (Llama 3, Mixtral)
GROQ_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Hugging Face (Serverless API)
HUGGINGFACE_API_KEY=

# Zhipu AI (GLM-4)
GLM_API_KEY=

# Cerebras (Ultra-fast Llama inference)
CEREBRAS_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# ========================================================
# Note: Local Providers (Ollama) and Community endpoints (llm7)
# do not require API keys!
