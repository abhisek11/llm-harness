# ─── LLM Harness — Free API Keys ────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# ALL providers below are 100% free — no credit card required.

# ── Groq ─────────────────────────────────────────────────────────────────────
# Sign up: https://console.groq.com/keys
# Free tier: 6,000 tokens/min, 14,400 req/day, 500K tokens/day
GROQ_API_KEY=

# ── Google Gemini (AI Studio) ─────────────────────────────────────────────────
# Sign up: https://aistudio.google.com/app/apikey
# Free tier: 15 req/min, 1,500 req/day, 1M tokens/min on Flash
GEMINI_API_KEY=

# ── Zhipu AI (GLM-4-Flash) ───────────────────────────────────────────────────
# Sign up: https://open.bigmodel.cn
# Free tier: GLM-4-Flash is completely free, 100 RPM
GLM_API_KEY=

# ── Cerebras ─────────────────────────────────────────────────────────────────
# Sign up: https://inference.cerebras.ai
# Free tier: 1M tokens/day, 30 RPM (world's fastest inference)
CEREBRAS_API_KEY=

# ── OpenRouter ───────────────────────────────────────────────────────────────
# Sign up: https://openrouter.ai/keys
# Free tier: multiple models with :free suffix, no credit card needed
OPENROUTER_API_KEY=

# ── LLM7.io ──────────────────────────────────────────────────────────────────
# No key needed — anonymous community endpoint (last-resort fallback)
# No config needed

# ── Server Port ───────────────────────────────────────────────────────────────
PORT=4141
